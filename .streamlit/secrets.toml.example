# Streamlit secrets example for SemanticMail.
#
# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# On Streamlit Community Cloud, set the same keys via the app dashboard.

# Required for live LLM calls. Treated as a secret — do not commit.
DEEPSEEK_API_KEY = "your_deepseek_api_key_here"

# Optional — only needed if you regenerate the GPT-OSS baseline cache.
OPENROUTER_API_KEY = "your_openrouter_api_key_here"

# Runtime authorization mode.
#   "public_demo" — cache-only. Cache misses raise LiveCallBlockedError
#                   and never hit the network. Use this on the public
#                   deployment.
#   "local_dev"   — cache misses hit the network, subject to a per-session
#                   rate limit (default 20). Use on your own machine.
#   "cli_warmer"  — cache misses hit the network with no rate limit.
#                   Set automatically by the warm_* CLI scripts inside
#                   their __main__ block.
#
# Unset or any other value → fail closed (same as "public_demo").
SEMANTICMAIL_RUNTIME = "public_demo"

# Optional: override the per-session live-call cap (local_dev only).
# SEMANTICMAIL_RATE_LIMIT = "20"
